{
  "version": 8,
  "name": "Blackout nm",
  "glyphs": "glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "geojson",
      "data": "osm.geojson",
      "attribution": "© OpenStreetMap contributors"
    },
    "contours": {
      "type": "geojson",
      "data": "contours.geojson"
    },
    "public-land": {
      "type": "geojson",
      "data": "layers/public_land.geojson"
    },
    "flood": {
      "type": "geojson",
      "data": "layers/flood.geojson"
    },
    "hazards": {
      "type": "geojson",
      "data": "layers/hazards.geojson"
    },
    "wild": {
      "type": "geojson",
      "data": "wild.geojson"
    },
    "hillshade": {
      "type": "image",
      "url": "hillshade.png",
      "coordinates": [
        [
          -106.68,
          35.25
        ],
        [
          -106.38,
          35.25
        ],
        [
          -106.38,
          35.06
        ],
        [
          -106.68,
          35.06
        ]
      ]
    }
  },
  "layers": [
    {
      "id": "void",
      "type": "background",
      "paint": {
        "background-color": "#0c0e10"
      }
    },
    {
      "id": "hillshade",
      "type": "raster",
      "source": "hillshade",
      "paint": {
        "raster-opacity": 0.38
      }
    },
    {
      "id": "public-land-fill",
      "type": "fill",
      "source": "public-land",
      "paint": {
        "fill-color": "#1a2a1a",
        "fill-opacity": 0.28
      }
    },
    {
      "id": "flood-fill",
      "type": "fill",
      "source": "flood",
      "paint": {
        "fill-color": "#143044",
        "fill-opacity": 0.28
      }
    },
    {
      "id": "water-fill",
      "type": "fill",
      "source": "osm",
      "filter": [
        "==",
        [
          "get",
          "natural"
        ],
        "water"
      ],
      "paint": {
        "fill-color": "#1a3a4a",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "water",
      "type": "line",
      "source": "osm",
      "filter": [
        "has",
        "waterway"
      ],
      "paint": {
        "line-color": "#3a6a88",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.8,
          15,
          2.6
        ]
      }
    },
    {
      "id": "contours",
      "type": "line",
      "source": "contours",
      "paint": {
        "line-color": "#6a7060",
        "line-width": 0.55,
        "line-opacity": 0.55
      }
    },
    {
      "id": "tracks",
      "type": "line",
      "source": "osm",
      "minzoom": 12,
      "filter": [
        "in",
        [
          "get",
          "highway"
        ],
        [
          "literal",
          [
            "track",
            "path",
            "footway",
            "bridleway",
            "cycleway",
            "steps"
          ]
        ]
      ],
      "paint": {
        "line-color": "#c4b48a",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.7,
          16,
          2.0
        ],
        "line-dasharray": [
          2,
          1.1
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "osm",
      "filter": [
        "has",
        "highway"
      ],
      "paint": {
        "line-color": "#c5cdd6",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.7,
          13,
          1.5,
          15,
          3.4,
          17,
          6.2
        ]
      }
    },
    {
      "id": "wild-roads",
      "type": "line",
      "source": "wild",
      "filter": [
        "has",
        "highway"
      ],
      "paint": {
        "line-color": "#e8eef4",
        "line-width": 2.4
      }
    },
    {
      "id": "hazards",
      "type": "line",
      "source": "hazards",
      "paint": {
        "line-color": "#c43b3b",
        "line-width": 1.2
      }
    },
    {
      "id": "osm-points",
      "type": "circle",
      "source": "osm",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Point"
      ],
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "circle-color": "#c5cdd6",
        "circle-radius": 2.2,
        "circle-stroke-color": "#0c0e10",
        "circle-stroke-width": 0.6
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "osm",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "has",
          "highway"
        ],
        [
          "any",
          [
            "has",
            "name"
          ],
          [
            "has",
            "ref"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name"
          ],
          [
            "get",
            "ref"
          ]
        ],
        "symbol-placement": "line",
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          12,
          14,
          15,
          16,
          19,
          18,
          22
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-max-angle": 40,
        "text-padding": 2,
        "text-optional": true,
        "symbol-spacing": 100,
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#B8BDC2",
        "text-halo-color": "#000000",
        "text-halo-width": 2.2
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "osm",
      "minzoom": 10,
      "maxzoom": 16,
      "filter": [
        "has",
        "place"
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          12,
          14,
          16
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-anchor": "top",
        "text-optional": true
      },
      "paint": {
        "text-color": "#B8BDC2",
        "text-halo-color": "#000000",
        "text-halo-width": 1.4
      }
    }
  ],
  "metadata": {
    "engine": "maplibre-metal-offline",
    "network": "deny-all",
    "attribution": "© OpenStreetMap contributors",
    "walkingZoom": true
  }
}
