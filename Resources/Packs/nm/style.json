{
  "version": 8,
  "name": "Blackout nm",
  "glyphs": "glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "osm": {
      "type": "vector",
      "url": "pmtiles://osm.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    },
    "contours": {
      "type": "geojson",
      "data": "contours.geojson"
    },
    "public-land": {
      "type": "geojson",
      "data": "layers/public_land.geojson"
    },
    "flood": {
      "type": "geojson",
      "data": "layers/flood.geojson"
    },
    "hazards": {
      "type": "geojson",
      "data": "layers/hazards.geojson"
    },
    "wild": {
      "type": "geojson",
      "data": "wild.geojson"
    },
    "hillshade": {
      "type": "image",
      "url": "hillshade.png",
      "coordinates": [
        [
          -107.45,
          35.95
        ],
        [
          -105.65,
          35.95
        ],
        [
          -105.65,
          34.35
        ],
        [
          -107.45,
          34.35
        ]
      ]
    }
  },
  "layers": [
    {
      "id": "void",
      "type": "background",
      "paint": {
        "background-color": "#000000"
      }
    },
    {
      "id": "hillshade",
      "type": "raster",
      "source": "hillshade",
      "paint": {
        "raster-opacity": 0.16,
        "raster-saturation": -0.65,
        "raster-brightness-max": 0.38,
        "raster-contrast": 0.12
      }
    },
    {
      "id": "public-land-fill",
      "type": "fill",
      "source": "public-land",
      "paint": {
        "fill-color": "#0a140a",
        "fill-opacity": 0.34
      }
    },
    {
      "id": "flood-fill",
      "type": "fill",
      "source": "flood",
      "paint": {
        "fill-color": "#0a1822",
        "fill-opacity": 0.34
      }
    },
    {
      "id": "water-fill",
      "type": "fill",
      "source": "osm",
      "filter": [
        "==",
        [
          "get",
          "natural"
        ],
        "water"
      ],
      "paint": {
        "fill-color": "#142430",
        "fill-opacity": 0.82
      },
      "source-layer": "water"
    },
    {
      "id": "water",
      "type": "line",
      "source": "osm",
      "filter": [
        "has",
        "waterway"
      ],
      "paint": {
        "line-color": "#3d6478",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.8,
          15,
          2.6
        ]
      },
      "source-layer": "water"
    },
    {
      "id": "contours",
      "type": "line",
      "source": "contours",
      "paint": {
        "line-color": "#2a2e28",
        "line-width": 0.45,
        "line-opacity": 0.4
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "osm",
      "filter": [
        "all",
        [
          "has",
          "highway"
        ],
        [
          "!",
          [
            "in",
            [
              "get",
              "highway"
            ],
            [
              "literal",
              [
                "track",
                "path",
                "footway",
                "bridleway",
                "cycleway",
                "steps"
              ]
            ]
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#000000",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          4.2,
          13,
          6.8,
          15,
          10.6,
          17,
          16.8
        ],
        "line-opacity": 0.96
      },
      "source-layer": "road"
    },
    {
      "id": "roads-arterial-casing",
      "type": "line",
      "source": "osm",
      "filter": [
        "in",
        [
          "get",
          "highway"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#E10600",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          3.6,
          13,
          5.6,
          15,
          9.0,
          17,
          15.0
        ],
        "line-opacity": 0.92
      },
      "source-layer": "road"
    },
    {
      "id": "roads",
      "type": "line",
      "source": "osm",
      "filter": [
        "all",
        [
          "has",
          "highway"
        ],
        [
          "!",
          [
            "in",
            [
              "get",
              "highway"
            ],
            [
              "literal",
              [
                "track",
                "path",
                "footway",
                "bridleway",
                "cycleway",
                "steps"
              ]
            ]
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#B8BDC2",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.9,
          13,
          2.4,
          15,
          5.0,
          17,
          9.4
        ]
      },
      "source-layer": "road"
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "osm",
      "filter": [
        "in",
        [
          "get",
          "highway"
        ],
        [
          "literal",
          [
            "motorway",
            "motorway_link",
            "trunk",
            "trunk_link",
            "primary",
            "primary_link",
            "secondary",
            "secondary_link"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#B8BDC2",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1.4,
          13,
          3.2,
          15,
          6.6,
          17,
          12.0
        ]
      },
      "source-layer": "road"
    },
    {
      "id": "tracks",
      "type": "line",
      "source": "osm",
      "minzoom": 12,
      "filter": [
        "in",
        [
          "get",
          "highway"
        ],
        [
          "literal",
          [
            "track",
            "path",
            "footway",
            "bridleway",
            "cycleway",
            "steps"
          ]
        ]
      ],
      "paint": {
        "line-color": "#B8BDC2",
        "line-opacity": 0.72,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.9,
          16,
          2.4
        ],
        "line-dasharray": [
          2,
          1.1
        ]
      },
      "source-layer": "road"
    },
    {
      "id": "wild-roads",
      "type": "line",
      "source": "wild",
      "filter": [
        "has",
        "highway"
      ],
      "paint": {
        "line-color": "#B8BDC2",
        "line-width": 2.6
      }
    },
    {
      "id": "hazards",
      "type": "line",
      "source": "hazards",
      "paint": {
        "line-color": "#E10600",
        "line-width": 1.4
      }
    },
    {
      "id": "osm-points",
      "type": "circle",
      "source": "osm",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Point"
      ],
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "circle-color": "#B8BDC2",
        "circle-radius": 2.4,
        "circle-stroke-color": "#000000",
        "circle-stroke-width": 0.8
      },
      "source-layer": "place"
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "osm",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "has",
          "highway"
        ],
        [
          "has",
          "name"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "symbol-placement": "line",
        "symbol-spacing": 100,
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          12,
          14,
          15,
          16,
          19,
          18,
          22
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-max-angle": 40,
        "text-padding": 2,
        "text-letter-spacing": 0.03,
        "text-optional": true,
        "text-keep-upright": true,
        "symbol-sort-key": [
          "match",
          [
            "get",
            "highway"
          ],
          [
            "motorway",
            "trunk",
            "primary"
          ],
          1,
          [
            "secondary",
            "tertiary"
          ],
          2,
          3
        ]
      },
      "paint": {
        "text-color": "#B8BDC2",
        "text-halo-color": "#000000",
        "text-halo-width": 2.2,
        "text-halo-blur": 0.15
      },
      "source-layer": "road"
    },
    {
      "id": "road-refs",
      "type": "symbol",
      "source": "osm",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "has",
          "highway"
        ],
        [
          "has",
          "ref"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "ref"
        ],
        "symbol-placement": "line",
        "symbol-spacing": 300,
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          15,
          14,
          18,
          16,
          21,
          17,
          23
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-max-angle": 28,
        "text-padding": 1,
        "text-letter-spacing": 0.06,
        "text-optional": true,
        "text-keep-upright": true,
        "symbol-sort-key": 0
      },
      "paint": {
        "text-color": "#E10600",
        "text-halo-color": "#B8BDC2",
        "text-halo-width": 2.0,
        "text-halo-blur": 0.05
      },
      "source-layer": "road"
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "osm",
      "minzoom": 10,
      "maxzoom": 16,
      "filter": [
        "has",
        "place"
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          13,
          14,
          18
        ],
        "text-font": [
          "Open Sans Regular"
        ],
        "text-anchor": "top",
        "text-optional": true,
        "text-letter-spacing": 0.04
      },
      "paint": {
        "text-color": "#B8BDC2",
        "text-halo-color": "#000000",
        "text-halo-width": 2.0
      },
      "source-layer": "place"
    }
  ],
  "metadata": {
    "engine": "maplibre-metal-offline",
    "network": "deny-all",
    "attribution": "© OpenStreetMap contributors",
    "walkingZoom": true,
    "palette": "blackout-void-red-silver",
    "tokens": {
      "void": "#000000",
      "accent": "#E10600",
      "silver": "#B8BDC2"
    }
  }
}
